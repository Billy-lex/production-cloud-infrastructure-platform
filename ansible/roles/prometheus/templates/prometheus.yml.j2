# Prometheus configuration
# Scrape targets for monitoring the infrastructure

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Prometheus self-monitoring
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          instance: "prometheus"
          environment: "{{ env }}"

  # Node Exporter - system metrics
  - job_name: "node_exporter"
    static_configs:
      - targets: ["localhost:9100"]
        labels:
          instance: "app-server"
          environment: "{{ env }}"

  # Application health endpoint (optional)
